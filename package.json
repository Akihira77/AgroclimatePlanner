{
  "name": "agroclimate-planner",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && pnpm db:migrate",
    "db:migrate": "pnpm --filter @agroclimate/database db:migrate",
    "db:generate": "pnpm --filter @agroclimate/database db:generate",
    "db:status": "pnpm --filter @agroclimate/database db:status",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "turbo": "2.11.12",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
