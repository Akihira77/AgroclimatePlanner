{
  "name": "@agroclimate/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --test test/unit/*.test.mjs",
    "test:integration": "pnpm build && node --test test/integration/*.test.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@agroclimate/contracts": "workspace:*",
    "@agroclimate/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
