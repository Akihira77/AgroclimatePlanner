    "@nestjs/platform-express": "12.5.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "catalog:",
