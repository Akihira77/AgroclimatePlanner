# Copy to .env for local overrides. Every value has a working default in
# docker-compose.yml and prisma.config.ts, so an empty .env still runs.
#
# The port is 5442 rather than 5432 because the dev host already runs unrelated
# PostgreSQL instances on 5432 and 5433.
POSTGRES_USER=agroclimate
POSTGRES_PASSWORD=agroclimate
POSTGRES_DB=agroclimate
POSTGRES_PORT=5442

# Consumed by Prisma. In production this is required; there is no default.
DATABASE_URL=postgresql://agroclimate:agroclimate@localhost:5442/agroclimate
