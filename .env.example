# Copy to .env for local work: `cp .env.example .env`
#
# One file, read by both Docker Compose and the Prisma CLI. Leave a value out and
# the defaults below apply everywhere; change one here and both sides follow,
# because Prisma derives its URL from these same variables.
#
# NODE_ENV=development is what selects development mode. Without it — and
# without DATABASE_URL — Prisma refuses to connect rather than falling back to
# localhost. Never set it in a deployed environment.
NODE_ENV=development

POSTGRES_USER=agroclimate
# Deliberately not the project name: a credential that doubles as an identifier
# turns up in logs and greps where it does not belong.
POSTGRES_PASSWORD=agroclimate-dev
POSTGRES_DB=agroclimate

# The port is 5442 rather than 5432 because this host already runs unrelated
# PostgreSQL instances on 5432 and 5433. Published to loopback only.
POSTGRES_PORT=5442

# Escape hatch, and required outside development. Overrides everything above.
# DATABASE_URL=postgresql://user:password@host:5432/database
