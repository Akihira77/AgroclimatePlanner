# Copy to .env for local work: `cp .env.example .env`
#
# One file, read by Docker Compose and the Prisma CLI. Leave a value out and the
# defaults below apply everywhere; change one here and both sides follow, because
# Prisma derives its migration URL from these same variables.
#
# NODE_ENV=development is what selects development mode. Without it — and
# without an explicit URL — connecting commands refuse to run rather than falling
# back to localhost. Never set it in a deployed environment.
NODE_ENV=development

POSTGRES_USER=agroclimate
# Deliberately not the project name: a credential that doubles as an identifier
# turns up in logs and greps where it does not belong.
POSTGRES_PASSWORD=agroclimate-dev
POSTGRES_DB=agroclimate

# The port is 5442 rather than 5432 because this host already runs unrelated
# PostgreSQL instances on 5432 and 5433. Published to loopback only.
POSTGRES_PORT=5442

# Role passwords, applied by `pnpm db:bootstrap`. Development placeholders; real
# environments must supply their own, and bootstrap refuses to run without them
# when NODE_ENV is not development.
MIGRATION_OWNER_PASSWORD=migration-owner-dev
APP_API_PASSWORD=app-api-dev
APP_SYSTEM_PASSWORD=app-system-dev

# Escape hatches, and required outside development. Each overrides everything
# above for its own connection. The API uses APP_API_DATABASE_URL; the worker
# will use APP_SYSTEM_DATABASE_URL. Neither may carry migration privileges, and
# the API never reads MIGRATION_DATABASE_URL — falling back to it would hand the
# tenant-facing process a schema-owner credential.
# MIGRATION_DATABASE_URL=postgresql://migration_owner:password@host:5432/database?schema=app
# APP_API_DATABASE_URL=postgresql://app_api:password@host:5432/database?schema=app
# APP_SYSTEM_DATABASE_URL=postgresql://app_system:password@host:5432/database?schema=app

# API process configuration (Phase 3.2, S2). Every value is validated at startup;
# an invalid one stops the process instead of degrading quietly.
# PORT=3000

# Comma-separated bare origins, no path, no trailing slash. Required in
# production; defaults to http://localhost:5173 in development. '*' is refused.
# CORS_ORIGINS=http://localhost:5173,https://app.example

# Express `trust proxy`. Default `false`. Accepts loopback, linklocal, uniquelocal,
# or CIDRs; `true` is refused because any caller could then choose their own IP
# through X-Forwarded-For. Set `loopback` when Caddy or nginx runs on the same host.
# TRUST_PROXY=loopback

# Accept a UUID X-Request-Id from a trusted upstream instead of minting one.
# Default false: an untrusted caller must not choose the correlation id.
# TRUST_REQUEST_ID_HEADER=false
