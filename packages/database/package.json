{
  "name": "@agroclimate/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --test test/unit/*.test.mjs",
    "db:generate": "prisma generate",
    "db:bootstrap": "node scripts/bootstrap.mjs",
    "db:verify": "node scripts/verify-privileges.mjs",
    "db:verify:probes": "node scripts/verify-probe-isolation.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "test:rls": "pnpm build && node --test test/rls/*.test.mjs",
    "test:schema": "pnpm build && node --test test/schema/*.test.mjs",
    "test:integration": "pnpm build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@agroclimate/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "eslint": "catalog:",
    "prisma": "7.10.1",
    "typescript": "catalog:"
  }
}
